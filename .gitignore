# ==========================================
# Специфичные файлы Qt / QMake / CMake
# ==========================================
# Папки сборки (build-папки, создаваемые Qt Creator или расширениями VS Code)
build*/
Build*/
*-build/

# Файлы генерации кода Qt (MOC, RCC, UI)
Makefile*
object_script.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qrc.depends

# Результаты компиляции Qt
*.moc
/.qmake.stash
/.qmake.cache

# ==========================================
# Специфичные файлы компиляции C++
# ==========================================
# Компилированные файлы объектов и библиотек
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Исполняемые файлы (бинарники)
*.exe
*.out
*.app

# Файлы отладки
*.d
*.pdb
*.ilk

# ==========================================
# Настройки редактора VS Code
# ==========================================
.vscode/
# Исключение: если вы хотите поделиться настройками задач и запуска с командой,
# раскомментируйте следующие строки, удалив символ '#' перед ними:
# !.vscode/tasks.json
# !.vscode/launch.json

# ==========================================
# Логи и временные файлы системы
# ==========================================
*.log
.DS_Store
Thumbs.db
